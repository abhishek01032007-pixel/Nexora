{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/abhishek01032007-pixel/Nexora/main/schemas/skill.manifest.v1.json",
  "title": "NexoraUniversalSkillManifest",
  "description": "Authoritative canonical metadata schema for individual Nexora skill packages (v1)",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "category",
    "publisher",
    "entrypoint",
    "platforms",
    "compatibility",
    "canonicalContentChecksum",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [1],
      "description": "Manifest format schema version (strictly 1 for v1.x)"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64,
      "description": "Immutable kebab-case unique identifier for the skill"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Human-readable display name for the skill"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Semantic version adhering to SemVer 2.0.0 (e.g. 1.0.0, 1.2.3, 1.3.0-beta.1)"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Concise plain text summary of the skill's capability and purpose"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Functional domain taxonomy classification (e.g. frontend, backend, security)"
    },
    "publisher": {
      "type": "object",
      "required": ["id", "name", "type"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Identifier of the publishing entity or organization"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Display name of the publisher"
        },
        "type": {
          "type": "string",
          "enum": ["first-party", "verified", "community"],
          "description": "Trust tier classification of the publisher"
        }
      }
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Relative file path to primary instruction markdown document inside package root"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 32
      },
      "description": "List of declared compatible platform identifiers (e.g. antigravity, cursor, copilot, claude-code, windsurf)"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minNexoraVersion": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "description": "Minimum required Nexora application version"
        },
        "maxNexoraVersion": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "description": "Maximum supported Nexora application version if upper-bounded"
        },
        "operatingSystems": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["windows", "macos", "linux"]
          },
          "description": "Operating systems supported by this skill"
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "description": "Target programming languages, libraries, or frameworks"
        },
        "requiredTools": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "description": "External tools or CLIs required for executing skill scripts"
        }
      }
    },
    "canonicalContentChecksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Deterministic SHA-256 composite tree hash of canonical source files"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skillId", "version"],
        "additionalProperties": false,
        "properties": {
          "skillId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "minLength": 3,
            "maxLength": 64
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "SemVer version constraint (e.g. >=1.0.0, ^1.2.0)"
          },
          "optional": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "Prerequisite skills required by this skill"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "type"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Relative normalized path inside package root"
          },
          "type": {
            "type": "string",
            "enum": ["content", "template", "reference", "script", "asset", "config"],
            "description": "Functional role of the packaged file"
          }
        }
      },
      "description": "Manifest of package files included in the skill distribution"
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "summary"],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "description": "Version string corresponding to this release entry"
          },
          "summary": {
            "type": "string",
            "maxLength": 512,
            "description": "Concise summary of release changes"
          },
          "changes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Detailed list of itemized changes"
          },
          "breakingChanges": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of breaking modifications or removed capabilities"
          },
          "migrationNotes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Instructions for updating existing configurations or workflows"
          }
        }
      },
      "description": "Structured release notes and historical change summaries"
    },
    "deprecated": {
      "type": "boolean",
      "default": false,
      "description": "Indicates if the skill is superseded or no longer recommended"
    },
    "replacedBy": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64,
      "description": "Skill ID of the recommended replacement skill if deprecated"
    },
    "license": {
      "type": "string",
      "maxLength": 64,
      "description": "SPDX license identifier (e.g. MIT, Apache-2.0)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]+$",
        "maxLength": 32
      },
      "description": "Search discovery keywords and taxonomy tags"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "description": "Declared capabilities or agent behaviors"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC creation timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC last modification timestamp"
    }
  }
}
