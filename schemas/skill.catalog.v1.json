{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/abhishek01032007-pixel/Nexora/main/schemas/skill.catalog.v1.json",
  "title": "NexoraSkillCatalog",
  "description": "Canonical schema for the remote Nexora skill catalog index (skills-index.json) v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogVersion",
    "channel",
    "generatedAt",
    "skills"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [1],
      "description": "Catalog schema version (strictly 1 for v1.x)"
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Catalog release version (SemVer 2.0.0)"
    },
    "channel": {
      "type": "string",
      "enum": ["stable", "beta"],
      "description": "Distribution channel for this catalog index"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp when this catalog index was generated"
    },
    "publisher": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" }
      },
      "additionalProperties": false
    },
    "minimumClientVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "metadata": {
      "type": "object"
    },
    "skills": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9]+(-[a-z0-9]+)*$": {
          "type": "object",
          "required": [
            "id",
            "name",
            "description",
            "category",
            "latestVersion",
            "publishedAt",
            "versions"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "minLength": 3,
              "maxLength": 64
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "latestVersion": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
            },
            "deprecated": {
              "type": "boolean"
            },
            "replacedBy": {
              "type": ["string", "null"],
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "publishedAt": {
              "type": "string",
              "format": "date-time"
            },
            "versions": {
              "type": "object",
              "minProperties": 1,
              "patternProperties": {
                "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$": {
                  "type": "object",
                  "required": [
                    "version",
                    "packageUrl",
                    "packageChecksum",
                    "canonicalContentChecksum",
                    "platforms",
                    "publishedAt"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "version": {
                      "type": "string",
                      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
                    },
                    "manifestUrl": {
                      "type": "string"
                    },
                    "packageUrl": {
                      "type": "string"
                    },
                    "packageChecksum": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$",
                      "description": "SHA-256 hex checksum of the downloadable .zip package"
                    },
                    "canonicalContentChecksum": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$",
                      "description": "SHA-256 tree checksum matching the skill manifest"
                    },
                    "platforms": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "enum": ["antigravity", "cursor", "copilot"]
                      },
                      "uniqueItems": true
                    },
                    "publishedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "releaseNotesUrl": {
                      "type": "string"
                    },
                    "minimumNexoraVersion": {
                      "type": "string",
                      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
